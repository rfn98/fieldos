generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@map("plants")
}

model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  manufacturer String
  model        String
  status       String
  plantId      String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plant              Plant               @relation(fields: [plantId], references: [id], onDelete: Cascade)
  incidents          Incident[]
  maintenanceRecords MaintenanceRecord[]
  workOrders         WorkOrder[]
  sops               Sop[]

  @@index([plantId])
  @@index([status])
  @@map("assets")
}

model Technician {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  specialization String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  incidents          Incident[]
  maintenanceRecords MaintenanceRecord[]
  workOrders         WorkOrder[]

  @@map("technicians")
}

model Incident {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique
  assetId      String    @db.Uuid
  title        String
  description  String
  rootCause    String
  severity     String
  occurredAt   DateTime
  resolvedAt   DateTime?
  technicianId String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id])

  @@index([assetId])
  @@index([technicianId])
  @@index([severity])
  @@index([occurredAt])
  @@map("incidents")
}

model MaintenanceRecord {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  assetId      String   @db.Uuid
  type         String
  title        String
  description  String
  actionTaken  String
  performedAt  DateTime
  technicianId String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id])

  @@index([assetId])
  @@index([technicianId])
  @@index([performedAt])
  @@map("maintenance_records")
}

model WorkOrder {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique
  assetId      String    @db.Uuid
  title        String
  description  String
  priority     String
  status       String
  scheduledAt  DateTime
  completedAt  DateTime?
  technicianId String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id])

  @@index([assetId])
  @@index([technicianId])
  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@map("work_orders")
}

model Sop {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  assetId   String   @db.Uuid
  title     String
  category  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([category])
  @@map("sops")
}